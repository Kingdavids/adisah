# Copy to .env.local for local dev, and add the same keys in Railway > service > Variables (redeploy after changes)

# Live domain, no trailing slash
NEXT_PUBLIC_SITE_URL=https://adisahafricanstore.com

# Google Analytics 4 measurement ID (Admin > Data streams > Web)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console "HTML tag" method: only the content="..." value
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Business Profile > "Ask for reviews" link, e.g. https://g.page/r/XXXX/review
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
